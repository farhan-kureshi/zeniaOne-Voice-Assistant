# =============================================================================
# Zenaipex AI — Platform Environment Variables
# =============================================================================

# --- Platform Identity ---
APP_NAME="Zenaipex AI"
APP_ENV=development               # development | staging | production
APP_BASE_URL=https://zenaipex.ai
APP_SECRET_KEY=                   # REQUIRED: 64+ char random string for JWT signing

# --- MongoDB (Shared DB, all tenants) ---
MONGODB_URI=                      # e.g. mongodb+srv://...
MONGODB_DB_NAME=zenaipex          # Platform database name

# --- Admin Bootstrapping ---
ADMIN_EMAIL=admin@example.com     # Default admin email for local dev/seeding
ADMIN_PASSWORD=change_this_pass   # Default admin password for local dev/seeding
ADMIN_NAME="Platform Admin"       # Default admin name


# --- Pinecone (Single index, per-company namespaces) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=zenaipex-knowledge
PINECONE_DIMENSION=384
PINECONE_REGION=us-east-1
PINECONE_CLOUD=aws

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- LLM Provider Abstraction ---
LLM_PROVIDER=sarvam               # sarvam | gemini | groq

# --- Sarvam AI (Platform-owned, shared across tenants) ---
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# --- Twilio (Platform-owned, shared across tenants initially) ---
# Note: In Phase 3, each company can bring their own Twilio creds.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_PHONE_NUMBER=

# --- Platform Webhook Base URL ---
# The public URL where Twilio will send webhooks (ngrok in dev, real domain in prod)
PLATFORM_WEBHOOK_BASE_URL=

# --- JWT Configuration ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Encryption (for storing Twilio/API secrets in DB) ---
ENCRYPTION_KEY=                   # Fernet key: run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`

# --- Email (for verification emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@zenaipex.ai

# --- Subscription Limits (platform defaults) ---
FREE_TRIAL_CALL_MINUTES=60
FREE_TRIAL_AGENTS=1
FREE_TRIAL_KB_DOCS=10
FREE_TRIAL_DAYS=14

STARTER_CALL_MINUTES=500
STARTER_AGENTS=3
STARTER_KB_DOCS=100

PRO_CALL_MINUTES=2000
PRO_AGENTS=10
PRO_KB_DOCS=1000

ENTERPRISE_CALL_MINUTES=999999
ENTERPRISE_AGENTS=999999
ENTERPRISE_KB_DOCS=999999
